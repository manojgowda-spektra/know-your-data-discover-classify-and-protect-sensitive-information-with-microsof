{
  "if": {
    "allOf": [
      {
        "field": "type",
        "equals": "Microsoft.Compute/virtualMachines"
      },
      {
        "anyOf": [
          {
            "not": {
              "allOf": [
                {
                  "field": "Microsoft.Compute/virtualMachines/storageProfile.imageReference.publisher",
                  "equals": "Spektra"
                },
                {
                  "field": "Microsoft.Compute/virtualMachines/storageProfile.imageReference.offer",
                  "equals": "cloudlabs-windows-jumpvm"
                },
                {
                  "field": "Microsoft.Compute/virtualMachines/storageProfile.imageReference.sku",
                  "equals": "win2019"
                }
              ]
            }
          },
          {
            "field": "Microsoft.Compute/virtualMachines/sku.name",
            "notIn": [
              "Standard_B2s",
              "Standard_B2ms",
              "Standard_D2as_v5",
              "Standard_D2s_v5",
              "Standard_D2s_v3"
            ]
          },
          {
            "field": "Microsoft.Compute/virtualMachines/storageProfile.osDisk.vhd.uri",
            "exists": "true"
          },
          {
            "field": "tags['Environment']",
            "exists": "false"
          },
          {
            "field": "tags['LabCode']",
            "exists": "false"
          },
          {
            "field": "tags['DeploymentID']",
            "exists": "false"
          }
        ]
      }
    ]
  },
  "then": {
    "effect": "deny"
  }
}
